{
  "name": "merkaall-mobile",
  "version": "1.0.3",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start --lan",
    "dev": "node node_modules/expo/bin/cli start --lan",
    "dev:clear": "node node_modules/expo/bin/cli start --lan --clear",
    "start:clear": "node node_modules/expo/bin/cli start --lan --clear",
    "start:tunnel": "node node_modules/expo/bin/cli start --tunnel",
    "android": "node node_modules/expo/bin/cli start --android",
    "ios": "node node_modules/expo/bin/cli start --ios",
    "web": "node node_modules/expo/bin/cli start --web",
    "eas:login": "node node_modules/eas-cli/bin/run login",
    "eas:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/eas-setup.ps1",
    "eas:setup:build": "powershell -ExecutionPolicy Bypass -File ./scripts/eas-setup.ps1 -Build",
    "ios:setup": "bash ./scripts/ios-setup.sh",
    "ios:setup:build": "bash ./scripts/ios-setup.sh --build",
    "eas:init": "eas init",
    "build:preview": "node node_modules/eas-cli/bin/run build --platform all --profile preview",
    "build:preview:android": "node node_modules/eas-cli/bin/run build --platform android --profile preview",
    "build:preview:ios": "node node_modules/eas-cli/bin/run build --platform ios --profile preview",
    "build:preview:ios:sim": "node node_modules/eas-cli/bin/run build --platform ios --profile ios-simulator",
    "build:production": "node node_modules/eas-cli/bin/run build --platform all --profile production",
    "submit:stores": "node node_modules/eas-cli/bin/run submit --platform all --profile production",
    "play:export-upload-cert": "node scripts/export-play-upload-cert.mjs",
    "play:check-keystores": "node scripts/check-keystores.mjs",
    "play:use-play-keystore": "node scripts/use-play-keystore.mjs",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@supabase/supabase-js": "2.106.1",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "^20.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.16",
    "typescript": "~5.9.2"
  }
}
