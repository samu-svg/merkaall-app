# Copie para .env e use os MESMOS valores do .env.local do backend Merkaall / PromoçõesPro
# (apenas troque o prefixo NEXT_PUBLIC_ por EXPO_PUBLIC_)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: monitoramento e analytics (no-op sem chaves / libs não instaladas)
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Opcional: token de acesso Expo (builds EAS sem "eas login" interativo)
# https://expo.dev/settings/access-tokens
# EXPO_TOKEN=
