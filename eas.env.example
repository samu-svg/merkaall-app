# Variáveis injetadas no build EAS (não commitar valores reais).
# Configure na nuvem — o .env local NÃO vai automaticamente para o build remoto.
#
#   npx eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "https://..." --environment preview --environment production --visibility plaintext
#   npx eas env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "eyJ..." --environment preview --environment production --visibility sensitive
#
# Ou pelo dashboard: https://expo.dev → projeto → Environment variables

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
