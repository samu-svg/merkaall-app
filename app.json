{
  "expo": {
    "name": "PromoçãoPro",
    "slug": "promocaopro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f97316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.promocaopro.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f97316"
      },
      "package": "com.promocaopro.app",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "scheme": "promocaopro",
    "plugins": [
      "expo-asset",
      "expo-notifications"
    ]
  }
}
